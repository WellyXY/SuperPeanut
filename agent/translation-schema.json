{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "translations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "text": { "type": "string" }
        },
        "required": ["index", "text"]
      }
    }
  },
  "required": ["translations"]
}
