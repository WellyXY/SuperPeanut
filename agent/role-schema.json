{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "location": { "type": "string" },
        "businessUnit": { "type": "string" },
        "function": { "type": "string" },
        "region": { "type": "string" },
        "priority": { "type": "string", "enum": ["SSS", "SS", "S"] },
        "openCount": { "type": "integer", "minimum": 0 },
        "nationality": { "type": "string" },
        "hiringManager": { "type": "string" },
        "updatedAt": { "type": "string" },
        "note": { "type": "string" }
      },
      "required": ["title", "location", "businessUnit", "function", "region", "priority", "openCount", "nationality", "hiringManager", "updatedAt", "note"]
    }
  },
  "required": ["role"]
}
