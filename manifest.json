{
  "manifest_version": 3,
  "name": "SuperPeanut",
  "version": "1.3.1",
  "description": "多公司 Skill 路由版：按公司背景与完整 HC/JD 生成并调用专属匹配 Skill。",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.linkedin.com/*", "https://sany-agent-temp.racoonn.me/*", "https://superpeanut-storage-production.up.railway.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 SuperPeanut",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["lib/storage.js", "lib/xlsx-parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.css", "assets/superpeanut.png", "assets/peanut-spritesheet.webp", "assets/mochi-running.webp", "assets/mochi-idle.webp", "assets/peanut-idle-00.png", "assets/peanut-idle-01.png", "assets/peanut-idle-02.png", "assets/peanut-idle-03.png", "assets/peanut-idle-04.png", "assets/peanut-idle-05.png"],
      "matches": ["https://www.linkedin.com/*"]
    }
  ]
}
